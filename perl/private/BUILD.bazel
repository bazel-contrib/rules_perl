load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":perl_tool.bzl", "perl_tool")

exports_files([
    "binary_wrapper.bat.tpl",
    "binary_wrapper.sh.tpl",
    "entrypoint.pl",
])

# The launcher template together with the runfiles library it sources: the
# POSIX library of rules_shell for the sh launcher, rules_batch's for the
# batch one. perl_binary carries both into the executable's runfiles.
filegroup(
    name = "binary_wrapper.tpl",
    srcs = select({
        "@platforms//os:windows": ["binary_wrapper.bat.tpl"],
        "//conditions:default": ["binary_wrapper.sh.tpl"],
    }),
    data = select({
        "@platforms//os:windows": ["@rules_batch//batch/runfiles"],
        "//conditions:default": ["@rules_shell//shell/runfiles"],
    }),
    visibility = ["//visibility:public"],
)

perl_tool(
    name = "xs_def",
    main = "xs_def.pl",
    visibility = ["//visibility:public"],
)

perl_tool(
    name = "xsubpp",
    main = "xsubpp.pl",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "perl_bzl",
    srcs = ["perl.bzl"],
    visibility = ["//perl:__subpackages__"],
    deps = [
        ":providers_bzl",
        "@bazel_skylib//lib:paths",
    ],
)

bzl_library(
    name = "perl_tool_bzl",
    srcs = ["perl_tool.bzl"],
    visibility = ["//perl:__subpackages__"],
)

bzl_library(
    name = "perl_version_bzl",
    srcs = ["perl_version.bzl"],
    visibility = ["//perl:__subpackages__"],
)

bzl_library(
    name = "perl_xs_bzl",
    srcs = ["perl_xs.bzl"],
    visibility = ["//perl:__subpackages__"],
    deps = [
        ":perl_tool_bzl",
        "@bazel_skylib//lib:new_sets",
        "@bazel_skylib//lib:paths",
        "@rules_cc//cc:defs_bzl",
        "@rules_cc//cc:find_cc_toolchain_bzl",
    ],
)

bzl_library(
    name = "providers_bzl",
    srcs = ["providers.bzl"],
    visibility = ["//perl:__subpackages__"],
)
