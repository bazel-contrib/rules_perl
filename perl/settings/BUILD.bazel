# The build settings of rules_perl; documented in README.md, "Toolchains".
#
# --//perl/settings:distribution picks the vendor of Perl, upstream or
# Strawberry. --//perl/settings:xs says whether the build needs a perl that
# can load XS modules; on Linux it picks the fully static perl (off, the
# default) or the dynamically linked glibc one (on). Every toolchain names in
# its target_settings the values that select it; see //perl:platforms.bzl.

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("//perl:platforms.bzl", "DISTRIBUTIONS")

package(default_visibility = ["//visibility:public"])

string_flag(
    name = "distribution",
    build_setting_default = "perl",
    values = DISTRIBUTIONS,
)

# One config_setting per distribution, for select() and for the toolchains.
[
    config_setting(
        name = "distribution_" + value,
        flag_values = {":distribution": value},
    )
    for value in DISTRIBUTIONS
]

bool_flag(
    name = "xs",
    build_setting_default = False,
)

config_setting(
    name = "xs_enabled",
    flag_values = {":xs": "True"},
)

config_setting(
    name = "xs_disabled",
    flag_values = {":xs": "False"},
)
