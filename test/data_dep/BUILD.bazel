load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# A shell program that runs a perl_binary it has as a data dependency, found
# by its rootpath. The scripts are written with write_file rather than a
# genrule so that no shell is needed to produce them on any platform.
write_file(
    name = "gen_program_sh",
    out = "program.sh",
    content = [
        "#!/bin/bash",
        "set -euxo pipefail",
        "genhtml=\"$1\"",
        "test \"$(\"$genhtml\" --version)\" == \"genhtml: LCOV version 2.6-0\"",
        "",
    ],
)

sh_binary(
    name = "program_bin",
    srcs = ["program.sh"],
    args = ["$(rootpath @lcov//:genhtml)"],
    data = ["@lcov//:genhtml"],
)

write_file(
    name = "gen_program_test_sh",
    out = "program_test.sh",
    content = [
        "#!/bin/sh",
        "exec env --ignore-environment test/data_dep/program_bin",
        "",
    ],
)
